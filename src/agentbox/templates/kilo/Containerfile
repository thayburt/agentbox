FROM @@BASE_IMAGE@@

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        nodejs \
        npm \
        openssh-client \
        python3 \
        python-is-python3 \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/0.12.1/install.sh | env UV_UNMANAGED_INSTALL=/usr/local/bin sh

RUN npm install -g @kilocode/cli@7.4.17 \
    && kilo --version

USER ubuntu

WORKDIR /workspace
